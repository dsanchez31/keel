# nginx configuration of the web image (build/web.Dockerfile). The image's
# entrypoint substitutes the environment variables it defines (KEELD_URL,
# WEB_PORT) and writes the result to /etc/nginx/conf.d/default.conf; nginx's
# own variables ($http_host, $http_upgrade, $uri) are not in the environment
# and pass through unchanged.

# The stream is a WebSocket: the upgrade is relayed when the browser asks for
# one, and the connection closed otherwise.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen      ${WEB_PORT};
    server_name _;
    root        /usr/share/nginx/html;

    # keeld's REST API and its stream (spec.md section 8).
    location /api/ {
        proxy_pass         ${KEELD_URL};
        proxy_http_version 1.1;
        # The browser's Host, port included. keeld refuses a state-changing
        # request and a stream handshake whose Origin differs from Host
        # (http.CrossOriginProtection and the WebSocket origin check):
        # rewriting Host to keeld's address, or dropping its port as $host
        # does, would make the operator's own page look cross-origin.
        proxy_set_header   Host $http_host;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection $connection_upgrade;
        # The stream stays open for the whole session, pinged by keeld, and a
        # replay's log streams as it is read: neither is buffered.
        proxy_read_timeout 1h;
        proxy_buffering    off;
        # keeld's own bound on a request body (internal/httpjson).
        client_max_body_size 1m;
    }

    # Vite's content-hashed bundles: a new build has new names.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files  $uri =404;
    }

    # Client-side routes (/replays/MSN-042) load the application.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
